# Local Ollama (LLM calls are restricted to prioritization and email drafting)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=12

# Email defaults to dry-run. Set gmail only after configuring OAuth credentials.
MAIL_MODE=dry-run
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Optional overrides
# DATABASE_PATH=./invoice_followup.db
# SEED_CSV=./clients.csv
