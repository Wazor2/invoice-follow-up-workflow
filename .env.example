# AR Copilot — Environment Configuration
# Copy to .env and fill in your values.

# ── Company Settings ────────────────────────────────────────
COMPANY_NAME=Demo Company Pvt Ltd
HIGH_VALUE_THRESHOLD_INR=100000
MAX_FOLLOW_UPS=2
TEST_MODE=true

# ── Email Mode ──────────────────────────────────────────────
# dry-run = simulated send (no real email)
# gmail   = send via Gmail API (requires OAuth credentials below)
# live    = alias for gmail
MAIL_MODE=dry-run

# ── Gmail OAuth (required only when MAIL_MODE=gmail) ───────
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# ── Google Sheets API (for production integration) ─────────
# GOOGLE_SHEET_ID=your_google_sheet_id
# GOOGLE_SHEET_RANGE=Invoices!A:Q

# ── Local Ollama LLM (optional) ────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=12

# ── Database ────────────────────────────────────────────────
# DATABASE_PATH=./invoice_followup.db
# SEED_CSV=./clients.csv
